# Expectation record for 01_integer_conversions/005_bool_conversions.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 005_bool_conversions
area               = 01_integer_conversions
description        = _Bool conversion from scalars and back, including values whose low bits are zero
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
A conversion to _Bool compares the value against zero, which is defined for every scalar
including the floating values used here, and yields 0 or 1.  The discriminating cases are
values that are nonzero overall but have zero low bits, where a truncating implementation
would answer 0; forming them involves no overflow.  Every property is computed twice, once from literal constants and once from
volatile-qualified storage, so the constant folder's answer cannot stand in for the
one the backend computes at run time.
No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
fold_from_zero=0
fold_from_one=1
fold_from_neg=1
fold_from_256=1
fold_from_u_high=1
fold_from_l_high=1
fold_from_double=1
fold_from_double_zero=0
fold_back_to_int=11
fold_sum=2
fold_not=1
fold_negate=-1
run_from_zero=0
run_from_one=1
run_from_neg=1
run_from_256=1
run_from_u_high=1
run_from_l_high=1
run_from_double=1
run_from_double_zero=0
run_back_to_int=11
run_sum=2
run_not=1
run_negate=-1
bool_promotes=int
bool_sum_type=int
END
