# Expectation record for 01_integer_conversions/007_enum_value_arithmetic.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 007_enum_value_arithmetic
area               = 01_integer_conversions
description        = Enumeration constants in arithmetic, gaps, differences and switch dispatch
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Every enumerator value is inside the range of int, so the enumeration's implementation-
defined underlying type cannot affect any printed value.  All sums, differences and
products stay well inside the int range, so no signed overflow occurs, and the size
relation is printed as a 0/1 comparison rather than as a width.
Every property is computed twice, once from literal constants and once from
volatile-qualified storage, so the constant folder's answer cannot stand in for the
one the backend computes at run time.
No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
fold_values=1 5 -3
fold_seq=0 1 2
fold_gap=10 11 20 21
fold_difference=4
fold_product=-6
fold_total=3
fold_index=33
fold_relation=1
fold_size_relation=1
run_values=1 5 -3
run_seq=1
run_gap=11 21
run_difference=4
run_product=-6
run_total=3
run_index=22
run_relation=1
run_switch=100 200 300
enumerator_type=int
enum_object_type=enum Color
enum_sum_type=int
END
