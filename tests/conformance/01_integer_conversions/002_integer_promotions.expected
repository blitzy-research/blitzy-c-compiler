# Expectation record for 01_integer_conversions/002_integer_promotions.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 002_integer_promotions
area               = 01_integer_conversions
description        = Integer promotion of narrow types as operands and in expressions, folded and volatile-runtime
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Each narrow operand promotes to int, which represents every value of the source type, so
every promotion is value-preserving.  Products and complements are chosen to stay inside
the range of int, so no signed overflow occurs, and every shift count is in range.
Every property is computed twice, once from literal constants and once from
volatile-qualified storage, so the constant folder's answer cannot stand in for the
one the backend computes at run time.
No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
fold_uchar_product=40000
fold_ushort_product=90000
fold_uchar_complement=-1
fold_schar_negate=128
fold_short_negate=300
fold_uchar_shift=1048576
fold_schar_widen=-129
run_uchar_product=40000
run_ushort_product=90000
run_uchar_complement=-1
run_schar_negate=128
run_short_negate=300
run_uchar_shift=1048576
run_schar_widen=-129
promo_uchar=int
promo_schar=int
promo_ushort=int
promo_short=int
promo_bool=int
promo_product=int
END
