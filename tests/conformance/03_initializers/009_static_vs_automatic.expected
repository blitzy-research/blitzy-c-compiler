round=1 after s_arr[0]=101 a_arr[0]=101
round=1 after s_arr[1]=102 a_arr[1]=102
round=1 after s_arr[2]=103 a_arr[2]=103
round=1 after s_st.p=8 s_st.q=9 a_st.p=8 a_st.q=9
round=2 s_counter=110 a_counter=100
round=2 s_arr[0]=101 a_arr[0]=1
round=2 s_arr[1]=102 a_arr[1]=2
round=2 s_arr[2]=103 a_arr[2]=3
round=2 s_st.p=8 s_st.q=9 a_st.p=7 a_st.q=8
round=2 after s_counter=120 a_counter=110
round=2 after s_arr[0]=201 a_arr[0]=101
round=2 after s_arr[1]=202 a_arr[1]=102
round=2 after s_arr[2]=203 a_arr[2]=103
round=2 after s_st.p=9 s_st.q=10 a_st.p=8 a_st.q=9
round=3 s_counter=120 a_counter=100
round=3 s_arr[0]=201 a_arr[0]=1
round=3 s_arr[1]=202 a_arr[1]=2
round=3 s_arr[2]=203 a_arr[2]=3
round=3 s_st.p=9 s_st.q=10 a_st.p=7 a_st.q=8
round=3 after s_counter=130 a_counter=110
round=3 after s_arr[0]=301 a_arr[0]=101
round=3 after s_arr[1]=302 a_arr[1]=102
round=3 after s_arr[2]=303 a_arr[2]=103
round=3 after s_st.p=10 s_st.q=11 a_st.p=8 a_st.q=9
g_static_scalar_after=1005
END
