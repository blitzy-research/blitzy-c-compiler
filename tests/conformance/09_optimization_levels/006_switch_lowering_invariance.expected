# Expectation record for 09_optimization_levels/006_switch_lowering_invariance.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 006_switch_lowering_invariance
area               = 09_optimization_levels
description        = Switch results unchanged across lowering strategies chosen by label density
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Every selector is derived from volatile storage, so no switch has a compile-time-known
selector.  No case label is duplicated in any switch, the dense, sparse and grouped label
sets are each internally distinct, and every accumulator stays inside the range of int.
No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
dense[0]=100
dense[1]=101
dense[2]=102
dense[3]=103
dense[4]=104
dense[5]=105
dense[6]=106
dense[7]=107
dense[8]=108
dense[9]=109
dense[10]=110
dense[11]=111
dense[12]=112
dense[13]=113
dense[14]=114
dense[15]=115
dense[16]=-1
dense[neg]=-1
sparse[-1000]=1
sparse[0]=2
sparse[7]=3
sparse[100]=4
sparse[1000]=5
sparse[65536]=6
sparse[1000000]=7
sparse[42]=0
grouped[0]=80
grouped[1]=30
grouped[2]=30
grouped[3]=30
grouped[4]=20
grouped[5]=40
grouped[6]=80
END
