# Expectation record for 09_optimization_levels/002_loop_invariance.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 002_loop_invariance
area               = 09_optimization_levels
description        = Loop results unchanged under invariant motion, strength reduction and unrolling
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Every loop terminates on a bound read from volatile storage and written immediately before
use, and every accumulator stays inside the range of its type, so no signed overflow can
occur however the loop is transformed.  No array is indexed out of bounds and no object is
read before assignment.  No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
sum_mul=135
sum_inv=210
sum_pow2=360
sum_big=499500
down=55
once=5
nested=1540
guarded=147
END
