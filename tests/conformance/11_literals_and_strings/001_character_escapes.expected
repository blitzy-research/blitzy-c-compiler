# Expectation record for 11_literals_and_strings/001_character_escapes.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 001_character_escapes
area               = 11_literals_and_strings
description        = Simple, octal and hexadecimal character escapes printed as explicit integer values
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Every escape result is printed as an integer value read through unsigned char, so no
plain-char signedness difference can be observed and no raw control byte is written to
stdout.  Every octal and hexadecimal escape denotes a value representable in unsigned char,
so no escape is out of range.  The source file is pure US-ASCII.  No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
