# Expectation record for 10_declarations_and_types/003_storage_class_linkage.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 003_storage_class_linkage
area               = 10_declarations_and_types
description        = static, extern and block-scope static with observable linkage and storage duration
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Every object with static storage duration is initialized by a constant expression or
implicitly zero-initialized, so no indeterminate value is read, and the block-scope static
accumulator is read only after its first assignment.  Each extern declaration is defined in
this same translation unit, so no undefined reference is relied upon.  All arithmetic stays
inside the range of int.  No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
file_static=7
extern_defined_here=42
block_static_accum=101 103 103
static_fn=21
zero_init=0
END
