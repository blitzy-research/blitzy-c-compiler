# Expectation record for 08_gcc_extensions/005_attribute_packed_aligned.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 005_attribute_packed_aligned
area               = 08_gcc_extensions
description        = Packing and alignment attributes and their observable effect on layout
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Each aggregate member is written and read back through the same member, so no padding byte
is ever observed and no type punning is relied upon.  Offsets are obtained with the offset
builtin rather than by pointer subtraction across subobjects.  Every value stored is inside
the range of its member's type, and no address is printed.  No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
attr_plain_size=12
attr_plain_align=4
attr_plain_off=0 4 8
attr_packed_size=7
attr_packed_align=1
attr_packed_off=0 1 5
attr_aligned_size=16
attr_aligned_align=16
attr_aligned_off=0 4
attr_both_size=8
attr_both_align=8
attr_both_off=0 1 5
attr_packed_saves=5
attr_packed_roundtrip=65 123456789 -321
attr_plain_roundtrip=-7 -2000000000 32767
attr_static_packed=1 2 3
attr_var_align16=1
attr_var_value=99
END
