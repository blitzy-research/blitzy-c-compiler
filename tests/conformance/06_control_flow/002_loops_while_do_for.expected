# Expectation record for 06_control_flow/002_loops_while_do_for.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 002_loops_while_do_for
area               = 06_control_flow
description        = All three loop forms with zero-iteration, single-iteration and countdown boundaries
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Every loop bound is read from volatile storage, so no iteration count is available for
compile-time substitution.  Each loop terminates: bounds are small positive constants or
volatile values written immediately before use, and every counter stays inside the range of
int.  No array is indexed out of bounds and no object is read before assignment.
No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
while_zero=0
while_one=1
while_sum=55
do_while_false_cond=1
do_while_one=1
do_while_squares=55
for_zero=0 i_after=0
for_one=1 i_after=1
for_forever_break=4
for_no_increment=6
for_continue_even_sum=20
while_continue_sum=37
nested_break=8 outer_iterations=4
nested_continue=12
for_do_while_mix=6
for_countdown_zero=0
for_countdown_three=3
END
