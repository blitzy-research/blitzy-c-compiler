# Expectation record for 06_control_flow/004_switch_edge_cases.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 004_switch_edge_cases
area               = 06_control_flow
description        = Empty body, default first, default absent, single label, and dense versus sparse label sets
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
No case label is duplicated in any switch and every selector is an initialized int whose
value is inside the range of the labels or deliberately outside them to reach default.  All
accumulation stays inside the range of int.  Each switch is driven once by a constant and
once from volatile storage, so no dispatch is available for compile-time substitution.
No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
const_empty_body=5 5
runtime_empty_body=5 5
const_default_first=2 3 1
runtime_default_first=2 3 1
const_default_absent=111 122 100
runtime_default_absent=111 122 100
const_single_label=1 0
runtime_single_label=1 0
const_unordered_labels=1 2 3 0
runtime_unordered_labels=1 2 3 0
const_dense=100 101 107 115 999 999
runtime_dense=100 101 107 115 999 999
const_dense_offset=1 5 8 0
runtime_dense_offset=1 5 8 0
const_sparse=1 2 3 4 5 6 0 0
runtime_sparse=1 2 3 4 5 6 0 0
dense_sweep_total=1720
sparse_sweep_total=21
END
