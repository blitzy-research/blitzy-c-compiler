# Expectation record for 06_control_flow/010_comma_operator_sequencing.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 010_comma_operator_sequencing
area               = 06_control_flow
description        = Comma operator sequencing with observable side effects in defined order
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
The sequence point between the two operands of a comma operator fully defines the order of
their side effects, so nothing here depends on unspecified evaluation order.  Each side
effect appends one decimal digit to a trace held in volatile storage, making the sequence
part of the program's observable behaviour, and every append is guarded by an explicit
range check so no write can leave the trace array.  No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
comma_chain order=123 len=3 tick=3
comma_chain_value=3
comma_nested order=1234 len=4 tick=4
comma_nested_value=4
comma_precedence order=12 len=2 tick=2
comma_precedence_value=1
comma_in_argument order=45 len=2 tick=2
comma_in_argument_value=5
for_comma i=5 j=5 iterations=5
while_comma_condition order=6666 len=4 tick=4
while_comma_condition_i=3
comma_in_ternary_true order=7 len=1 tick=1
comma_in_ternary_true_value=70
comma_in_ternary_false order=8 len=1 tick=1
comma_in_ternary_false_value=80
comma_volatile_writes r=2 vsel=2
comma_in_switch_control order=9 len=1 tick=1
comma_in_switch_control_value=20
comma_in_if_control order=12 len=2 tick=2
comma_in_if_control_value=2
comma_in_do_while order=555 len=3 tick=3
comma_in_do_while_i=3
END
