# Expectation record for 06_control_flow/008_goto_and_labels.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 008_goto_and_labels
area               = 06_control_flow
description        = Forward and backward goto, jumps out of nested blocks, and label-driven cleanup paths
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Only well-defined jumps are used.  No jump enters the scope of a variably-modified type,
because no variable-length array is declared anywhere, and no jump bypasses an
initialisation that is later read: every object is declared at the top of its function and
given its value by an ordinary assignment rather than by an initialiser a jump could skip.
Every loop formed by a backward goto terminates.  No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
forward_goto=1
backward_goto sum=15 i=5
goto_out_of_nested sum=4 steps=5
goto_into_block_taken=10
goto_into_block_not_taken=511
null_statement_label=0
goto_as_continue sum=6
cleanup_path=111 222 300
runtime_cleanup_path_first=111
runtime_cleanup_path_second=222
runtime_cleanup_path_none=300
switch_goto=1 12 3
runtime_switch_goto_one=1
runtime_switch_goto_two=12
runtime_switch_goto_default=3
goto_loop=0 1 55
runtime_goto_loop_zero=0
runtime_goto_loop_ten=55
END
