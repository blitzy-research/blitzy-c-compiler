# Expectation record for 06_control_flow/001_if_else_chains.c
#
# Reproduce one cell by hand with no harness: render the three command templates
# below, substituting the target triple, the optimization level, the source path,
# the output path, and the target's runner (empty on the natively executing target).

program            = 001_if_else_chains
area               = 06_control_flow
description        = Deep selection chains, nested conditions and first-match ordering
targets            = x86_64, i686, aarch64, riscv64
opt_levels         = -O0, -O1, -O2
shared_flags       = -static
bcc_command        = $BCC --target <triple> <opt> -static <src> -o <out>
ref_command        = $REF_CC_<TRIPLE> <opt> -static <src> -o <out>
run_command        = <runner> <out>
expect_exit        = 0
oracle_a           = enabled
oracle_b           = enabled
oracle_c           = enabled
ub_notes           <<END
Every branch condition is a defined comparison over initialized objects, and every object
read has been assigned first.  All arithmetic stays inside the range of int.  Each chain is
driven twice, once by a constant and once by a selector read from volatile storage, so the
branch cannot be resolved at compile time in the second case.
No header is included and printf is declared by hand, so nothing here depends on a
standard-library header bcc does not ship.
END
expected_stdout    <<END
const_classify=1 2 3 4 5 6 7
runtime_classify=1 2 3 4 5 6 7
const_nested=111 110 101 100 11 10 1 0
runtime_nested=111 110 101 100 11 10 1 0
const_nested_else=2 1 -1 -1
runtime_nested_else=2 1 -1 -1
const_first_match=1 2 3 4 1
runtime_first_match=1 2 3 4 1
const_no_else=4 9
runtime_no_else=4 9
END
